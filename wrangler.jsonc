{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-apptr",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "55715085-738b-4432-a506-091cd2b368e8","database_name": "DW33223" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f74a09d86f4d4083b644e4fb6ae43b85" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
